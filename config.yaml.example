# ─────────────────────────────────────────────────────────────────────────────
# Nolvus Translator v2 — config.yaml.example
# Copy this to config.yaml and fill in your own values.
# config.yaml is in .gitignore so secrets never end up in git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Models ────────────────────────────────────────────────────────────────────
models:
  # HuggingFace access token for gated/private model downloads. Used as the default;
  # can be overridden per-download in the UI. Never logged. (config.yaml is gitignored.)
  hf_token: ""

# ── Paths ─────────────────────────────────────────────────────────────────────
paths:
  model_cache_dir:  "models"          # relative to project root; models/ is gitignored
  # Single mods folder (old format, still supported):
  # mods_dir: "H:/Nolvus/Instances/Nolvus Awakening/MODS/mods"
  # Multiple mods folders (new format — all will be scanned and shown in the UI):
  mods_dirs:
    - "H:/Nolvus/Instances/Nolvus Awakening/MODS/mods"
    # - "H:/AnotherProfile/MODS/mods"
  backup_dir:       "H:/Nolvus/Instances/Nolvus Awakening/MODS/mods_backup"
  bsarch_exe:       "H:/Nolvus/Instances/Nolvus Awakening/TOOLS/BSArch/BSArch.exe"
  temp_dir:         "H:/Nolvus/Temp/bsa_extract"
  nexus_cache:      "cache/nexus_cache.json"
  translation_cache: "cache/translation_cache.json"
  skyrim_terms:     "data/skyrim_terms.json"
  log_file:         "logs/translator.log"

# ── Nexus Mods API ────────────────────────────────────────────────────────────
nexus:
  api_key:              "YOUR_NEXUS_API_KEY_HERE"
  game:                 "skyrimspecialedition"
  request_timeout_sec:  10
  cache_ttl_days:       30

  # ── Mod downloader (translator/nexus — see its README.md) ──────────────────
  # Where finished archives land. Point at the Nolvus ARCHIVE folder to fill an
  # existing install in place.
  download_dir:         "cache/downloads"
  # auto    — ask Nexus whether the key is Premium and pick accordingly: a Premium
  #           key uses the API, a free one mints through the browser and keeps the
  #           click handoff behind it as a fallback
  # premium — API only (download_link.json); fails on a free key
  # browser — mint through a signed-in Chrome; fails if there is no session
  # nxm     — always go through the "Mod Manager Download" click handoff
  link_mode:            "auto"
  max_concurrent:       3
  max_retries:          3
  download_timeout_sec: 30
  chunk_size_kb:        256
  # How long a free-account download waits for the user to click Mod Manager
  # Download before giving up on that file.
  nxm_timeout_sec:      300
  # Let a waiting download open a browser tab itself. Leave false when the server
  # is headless or remote — the UI shows item.nexus_url instead.
  nxm_open_browser:     false

  # ── Browser link minting (translator/nexus/browser.py) ─────────────────────
  # What makes a free account download unattended: a real Chrome holding your Nexus
  # session asks the site for the same signed CDN URL its own download page asks for.
  # You sign in once, in a window you can see; nothing is asked of you after that.
  browser_enabled:      true
  # Empty = auto-detect the usual install locations.
  chrome_path:          ""
  # A dedicated profile, not your everyday one. The sign-in lives here.
  browser_profile_dir:  "cache/nexus_chrome"
  # Headless Chrome cannot be signed in by hand and reads differently to bot
  # management; leave false unless the profile is already signed in and you know why.
  browser_headless:     false
  # Seconds between mints — pacing, not throttling around a limit.
  browser_mint_interval_sec: 1.5
  # How long a download waits for a sign-in when the profile has none. 0 = fail at
  # once with an actionable message (right for a headless host).
  browser_login_wait_sec:    300
  # Cloudflare declines a headless browser (measured: 403 + challenge page), so there
  # is a real window. These keep it out of the way rather than pretend otherwise.
  # minimized (default) | offscreen | normal
  browser_window_mode:       "minimized"
  # Close Chrome after this long with nothing to mint. 0 = keep it for the process.
  browser_idle_close_sec:    600
  # A minted link lasts four hours; caching them means retries, re-submitted batches
  # and restarts need no browser at all.
  link_cache_enabled:        true
  link_cache_path:           "cache/nexus_links.json"

  # ── Search (translator/nexus/search.py) ────────────────────────────────────
  # Search lives on Nexus's GraphQL API, not on the v1 REST API — v1 has no search
  # at all. Seconds between search calls; 0 is fine for a UI search box, raise it
  # when sweeping a whole modlist for translations.
  search_min_interval_sec: 0.0

  # ── Translate From Mod ─────────────────────────────────────────────────────
  # Pull an existing published translation of a mod into our strings. Needs 7-Zip
  # to unpack .7z/.rar donors; empty auto-detects, including Nolvus's lib/7z.exe.
  archive_tool_path:    ""
  # Scratch space for donor archives. They are deleted once their strings are out.
  donor_dir:            "cache/donors"

# ── Ensemble Pipeline ─────────────────────────────────────────────────────────
ensemble:
  # Model A — MT specialist (fast, WMT25 champion)
  model_a:
    repo_id:            "tencent/HY-MT1.5-7B-GPTQ-Int4"
    local_dir_name:     "HY-MT1.5-7B-GPTQ-Int4"
    device:             "cuda:0"
    max_new_tokens:     2048
    temperature:        0.7
    top_k:              20
    top_p:              0.6
    repetition_penalty: 1.05
    batch_size:         20

  # Model B — powerful LLM (context-rich, used for long strings + arbiter)
  model_b:
    repo_id:            "Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4"
    local_dir_name:     "Qwen2.5-14B-Instruct-GPTQ-Int4"
    device:             "cuda:0"
    max_new_tokens:     3000
    temperature:        0.3
    top_p:              0.9
    repetition_penalty: 1.05
    batch_size:         15
    cpu_offload:        false
    max_memory:
      "cuda:0":  "14GiB"

  use_translation_cache:   true

# ── Context Pipeline ──────────────────────────────────────────────────────────
context:
  max_desc_chars:           200
  summarize_threshold_chars: 400
  use_neural_summarizer:    true
  max_related_records:      3

# ── Translation Behavior ──────────────────────────────────────────────────────
translation:
  source_lang:    "English"
  target_lang:    "Russian"
  # Embedded (non-localized) ESP string output encoding. Default utf-8 (Skyrim SE
  # localized plugins). Set to "cp1251" if Russian text shows as mojibake in-game.
  string_encoding: "utf-8"
  preserve_tokens:
    - "<Alias="
    - "<mag>"
    - "<dur>"
    - "<Global="
    - "<ActorValue="
    - "<br>"
    - "\\n"
    - "%d"
    - "%s"
    - "%i"
    - "%f"
    - "MCM"
    - "SKSE"
    - "SkyUI"
    - "DPAD"
    - "HUD"
    - "ENB"
    - "MO2"
  min_latin_ratio:    0.15
  max_cyrillic_ratio: 0.30

# ── Logging ───────────────────────────────────────────────────────────────────
logging:
  level:          "INFO"
  log_to_file:    true
  log_to_console: true
  max_log_size_mb: 10
  backup_count:   3

# ── Remote Translation ─────────────────────────────────────────────────────────
remote:
  # mode: local | remote | auto
  #   local  — always use local GGUF models (default)
  #   remote — always use a remote Skylator server (requires server_url)
  #   auto   — try remote first (if discovered via LAN), fall back to local
  mode:            "local"
  server_url:      ""         # leave blank for auto-discovery, or set explicit URL
                              # e.g. "http://192.168.1.10:8765"
  timeout_sec:     30.0
  scan_on_startup: false      # run LAN scan automatically when web UI starts
  mdns_enabled:    true       # announce/discover via mDNS (requires zeroconf)
  port:            8765       # default port for the translation server
  # agent_hub_port: 8770      # if set, master listens for persistent agent-dialed socket
                              # links — instant master→agent push + event-driven telemetry
                              # without agents being inbound-reachable (agent dials out).
                              # Leave unset to use the durable HTTP pull/heartbeat path only.
